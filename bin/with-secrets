#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--version" ]]; then
    echo "with-secrets 0.3"
    exit 0
fi

usage() {
    cat <<'EOF'
usage: with-secrets FILE.env [FILE2.env ...] -- COMMAND [ARG ...]

Run one command with SOPS dotenv values in its environment. Decrypted values
remain in process memory; no plaintext temporary file is created.
EOF
}

files=()
while (($#)); do
    case "$1" in
        --) shift; break ;;
        -h|--help) usage; exit 0 ;;
        *) files+=("$1"); shift ;;
    esac
done

if ((${#files[@]} == 0)) || (($# == 0)); then
    usage >&2
    exit 2
fi

for file in "${files[@]}"; do
    [[ -f "$file" ]] || {
        printf 'with-secrets: file not found: %s\n' "$file" >&2
        exit 1
    }
done

shell_join() {
    local joined=""
    local arg quoted
    for arg in "$@"; do
        printf -v quoted '%q' "$arg"
        joined+="${joined:+ }${quoted}"
    done
    printf '%s' "$joined"
}

# sops's built-in key discovery looks under the platform config directory —
# ~/Library/Application Support on macOS — but ./setup writes the age key to
# the XDG path on every platform. Point sops at the course location unless the
# caller already chose a key source.
if [[ -z "${SOPS_AGE_KEY_FILE:-}" && -z "${SOPS_AGE_KEY:-}" ]] \
    && [[ -f "${HOME}/.config/sops/age/keys.txt" ]]; then
    export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
fi

# sops exec-env is the structured primitive for this job: it decrypts directly
# into a child environment and never materializes plaintext on disk. Nest one
# invocation per file so later files override earlier ones while preserving the
# FILE... interface.
command="$(shell_join "$@")"
for ((i = ${#files[@]} - 1; i >= 0; i--)); do
    printf -v quoted_file '%q' "${files[$i]}"
    printf -v quoted_command '%q' "$command"
    command="sops exec-env --same-process ${quoted_file} ${quoted_command}"
done

exec bash -c "$command"
