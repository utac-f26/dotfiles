#!/usr/bin/env bash
set -euo pipefail

MODEL="gemini-3.1-pro-preview"
OUTPUT=""

usage() {
    cat <<'EOF'
usage: gemini-ask [--model MODEL] [--output FILE] PROMPT.md

Send one prompt file to Gemini through the google-genai SDK. Requires
GEMINI_API_KEY in the environment, usually via with-secrets secrets/gemini.env.
EOF
}

while (($#)); do
    case "$1" in
        --model) MODEL="${2:-}"; shift 2 ;;
        --output) OUTPUT="${2:-}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
        *) break ;;
    esac
done

PROMPT="${1:-}"
[[ -n "$PROMPT" && -f "$PROMPT" ]] || { usage >&2; exit 2; }
[[ -n "${GEMINI_API_KEY:-}" ]] || { echo "GEMINI_API_KEY is not set" >&2; exit 1; }
if [[ -z "$OUTPUT" ]]; then
    OUTPUT="${PROMPT%.*}.gemini.resp.md"
fi

uv run --with google-genai python3 - "$MODEL" "$PROMPT" "$OUTPUT" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

from google import genai

model = sys.argv[1]
prompt = Path(sys.argv[2]).read_text()
output = Path(sys.argv[3])

client = genai.Client()
response = client.models.generate_content(
    model=model,
    contents=prompt,
)
text = response.text or ""
output.write_text(text)
print(output)
PY
