{
  "autoMemoryEnabled": false,
  "cleanupPeriodDays": 120,
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-breadcrumbs.py\" sessionend",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/agent-log-keeper\" claude",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/claude-breadcrumbs.py\" sessionstart",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/agent-log-keeper\" claude",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/agent-log-keeper\" claude",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
