{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/agent-log-keeper\" codex",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/agent-log-keeper\" codex",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/bin/agent-log-keeper\" codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
