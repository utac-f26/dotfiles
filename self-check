#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
RECEIPT="${REPO_ROOT}/.setup-receipt.json"
VERSION=7
REQUIRED_TOOLS="${REPO_ROOT}/required-tools.txt"
TOOL_VERSIONS="${REPO_ROOT}/tool-versions.txt"
UPSTREAM_URL="$(tr -d '[:space:]' <"${REPO_ROOT}/upstream-url")"
# shellcheck disable=SC1091 # REPO_ROOT is resolved before sourcing.
source "${REPO_ROOT}/lib/tool-versions.sh"
TMP_DIR="$(mktemp -d)"
CHECKS_TSV="${TMP_DIR}/checks.tsv"
TOOLS_TSV="${TMP_DIR}/tools.tsv"
FAILURES=0

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

sanitize() {
    printf '%s' "$1" | tr '\t\n' '  '
}

add_check() {
    local name="$1"
    local passed="$2"
    local detail
    detail="$(sanitize "$3")"
    printf '%s\t%s\t%s\n' "$name" "$passed" "$detail" >>"$CHECKS_TSV"
    if [[ "$passed" != "true" ]]; then
        FAILURES=$((FAILURES + 1))
        printf 'FAIL %-24s %s\n' "$name" "$detail" >&2
    else
        printf 'OK   %-24s %s\n' "$name" "$detail" >&2
    fi
}

normalize_path() {
    local path="$1"
    case "$path" in
        "$HOME"/*) printf '%s/%s' "~" "${path#"$HOME"/}" ;;
        "$REPO_ROOT"/*) printf 'repo:%s' "${path#"$REPO_ROOT"/}" ;;
        /*) printf 'system:%s' "$path" ;;
        *) printf '%s' "$path" ;;
    esac
}

python311() {
    if [[ -n "${DOTFILES_PYTHON:-}" ]]; then
        "${DOTFILES_PYTHON}" "$@"
    else
        uv run --no-project --python 3.11 python "$@"
    fi
}

github_remote_identity() {
    printf '%s\n' "$1" \
        | LC_ALL=C tr '[:upper:]' '[:lower:]' \
        | sed -E \
            -e 's#^https?://([^/@]+@)?github.com/##' \
            -e 's#^ssh://([^/@]+@)?github.com/##' \
            -e 's#^[^/@]+@github.com:##' \
            -e 's#^git://github.com/##' \
            -e 's#\.git/?$##' \
            -e 's#/$##'
}

version_for() {
    local tool="$1"
    local output
    case "$tool" in
        ssh) output="$(ssh -V 2>&1)" || return 1 ;;
        *) output="$("$tool" --version 2>&1)" || return 1 ;;
    esac
    utac_version_line "$output"
}

add_tool() {
    local tool="$1"
    local path version minimum
    path="$(command -v "$tool" 2>/dev/null || true)"
    if [[ -z "$path" || ! -x "$path" ]]; then
        printf '%s\t%s\t%s\n' "$tool" "missing" "" >>"$TOOLS_TSV"
        return 1
    fi
    if ! version="$(version_for "$tool")"; then
        printf '%s\t%s\t%s\n' \
            "$tool" "$(normalize_path "$path")" "" >>"$TOOLS_TSV"
        return 1
    fi
    version="$(sanitize "$version")"
    if [[ -z "$version" ]]; then
        printf '%s\t%s\t%s\n' \
            "$tool" "$(normalize_path "$path")" "" >>"$TOOLS_TSV"
        return 1
    fi
    # An empty version means the tool could not be run or said nothing. A tool
    # that reports a version the pin rejects still records that version, so the
    # failure names what the student has installed.
    minimum="$(utac_pinned_version "$TOOL_VERSIONS" "$tool" 2>/dev/null || true)"
    if [[ -n "$minimum" ]] \
        && ! utac_version_is_compatible "$version" "$minimum"; then
        printf '%s\t%s\t%s\n' \
            "$tool" "$(normalize_path "$path")" "$version" >>"$TOOLS_TSV"
        return 1
    fi
    printf '%s\t%s\t%s\n' \
        "$tool" "$(normalize_path "$path")" "$version" >>"$TOOLS_TSV"
}

check_managed_links() {
    local detail
    if detail="$("${REPO_ROOT}/links" --check 2>&1)"; then
        add_check "managed_links" true \
            "all declared links and the app-owned Codex config are current"
    else
        add_check "managed_links" false "$detail"
    fi
}

check_core_tools() {
    local unavailable=()
    local since tool extra
    : >"$TOOLS_TSV"
    while read -r since tool extra; do
        [[ -n "$since" && "$since" != \#* ]] || continue
        if [[ ! "$since" =~ ^[1-9][0-9]*$ || -z "$tool" || -n "$extra" ]]; then
            add_check "core_tools" false \
                "required-tools.txt has an invalid contract line"
            return
        fi
        ((since <= VERSION)) || continue
        if ! add_tool "$tool"; then
            unavailable+=("$tool")
        fi
    done <"$REQUIRED_TOOLS"
    if ((${#unavailable[@]} == 0)); then
        add_check "core_tools" true \
            "required commands resolve on PATH and meet version requirements"
    else
        add_check "core_tools" false \
            "missing, unusable, or unsupported: ${unavailable[*]}"
    fi
}

check_kit_revision() {
    local stamp="${REPO_ROOT}/KIT_REV"
    if [[ -f "$stamp" ]] \
        && grep -Eq '^[1-9][0-9]*\.[0-9a-f]{12}$' "$stamp"
    then
        add_check "kit_revision" true "$(tr -d '[:space:]' <"$stamp")"
    else
        add_check "kit_revision" false "KIT_REV is missing or malformed"
    fi
}

check_update_remote() {
    local upstream origin origin_id origin_push origin_push_id upstream_id
    local pull_remote pull_ref push_remote branch_push_remote push_default
    local rebase branch_rebase pull_ff
    upstream="$(git -C "$REPO_ROOT" remote get-url upstream 2>/dev/null || true)"
    origin="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
    origin_id="$(github_remote_identity "$origin")"
    origin_push="$(git -C "$REPO_ROOT" remote get-url --push origin 2>/dev/null || true)"
    origin_push_id="$(github_remote_identity "$origin_push")"
    upstream_id="$(github_remote_identity "$upstream")"
    pull_remote="$(git -C "$REPO_ROOT" config --get branch.main.remote || true)"
    pull_ref="$(git -C "$REPO_ROOT" config --get branch.main.merge || true)"
    push_remote="$(git -C "$REPO_ROOT" config --get remote.pushDefault || true)"
    branch_push_remote="$(git -C "$REPO_ROOT" config --get branch.main.pushRemote || true)"
    push_default="$(git -C "$REPO_ROOT" config --get push.default || true)"
    rebase="$(git -C "$REPO_ROOT" config --get pull.rebase || true)"
    branch_rebase="$(git -C "$REPO_ROOT" config --get branch.main.rebase || true)"
    pull_ff="$(git -C "$REPO_ROOT" config --get pull.ff || true)"
    if [[ "$upstream" == "$UPSTREAM_URL" \
        && -n "$origin" \
        && "$origin_id" != "$upstream_id" \
        && "$origin_push_id" == "$origin_id" \
        && "$pull_remote" == upstream \
        && "$pull_ref" == refs/heads/main \
        && "$push_remote" == origin \
        && "$branch_push_remote" == origin \
        && "$push_default" == simple \
        && "$rebase" == false \
        && "$branch_rebase" == false \
        && "$pull_ff" == true ]]
    then
        add_check "update_remote" true \
            "git pull reads the course template; git push writes personal origin"
    else
        add_check "update_remote" false "rerun ./setup to configure Git updates"
    fi
}

check_github_auth() {
    if gh auth status --hostname github.com >/dev/null 2>&1; then
        add_check "github_auth" true "GitHub CLI authenticated to github.com"
    else
        add_check "github_auth" false "run gh auth login for github.com"
    fi
}

check_codex_auth() {
    if codex login status >/dev/null 2>&1; then
        add_check "codex_auth" true \
            "Codex CLI signed in with a ChatGPT account"
    else
        add_check "codex_auth" false \
            "run codex login with your UT ChatGPT account"
    fi
}

check_claude_auth() {
    # `claude auth status` exits 0 whether or not anyone is signed in; the
    # JSON loggedIn field is the actual answer. Written to a file, not piped:
    # a jq that exits early would SIGPIPE the writer under pipefail.
    local status_json="${TMP_DIR}/claude-auth.json"
    if claude auth status >"$status_json" 2>/dev/null \
        && jq -e '.loggedIn == true' "$status_json" >/dev/null 2>&1; then
        add_check "claude_auth" true \
            "Claude Code signed in with a Claude account"
    else
        add_check "claude_auth" false \
            "run claude auth login with your UT Claude account"
    fi
}

check_age_key() {
    local key_file="${HOME}/.config/sops/age/keys.txt"
    local marker="AGE-SECRET-""KEY-"
    local mode=""
    if [[ -e "$key_file" ]]; then
        # GNU first, BSD second. The reverse order looks equivalent but is not:
        # on GNU, -f is --file-system, so '%Lp' is read as a FILE operand. That
        # errors on '%Lp' (so the || fires) while still printing the real file's
        # filesystem block to stdout, and the fallback's 600 is appended to it.
        # mode then never equals 600 and age_key fails on every Linux machine.
        # stat -c is rejected outright by BSD stat, so this order is safe there.
        mode="$(stat -c '%a' "$key_file" 2>/dev/null \
            || stat -f '%Lp' "$key_file" 2>/dev/null || true)"
    fi
    if [[ -s "$key_file" && ! -L "$key_file" && -O "$key_file" \
        && "$mode" == 600 ]] \
        && grep -q "$marker" "$key_file"
    then
        add_check "age_key" true \
            "age key exists outside the repo with mode 0600"
    else
        add_check "age_key" false \
            "age key must exist, be owned by you, and have mode 0600"
    fi
}

check_secrets_roundtrip() {
    local plain enc key_file recipient
    # Keep the fixture outside the repository but under secrets/ so the path
    # has the same shape as files governed by the repository's SOPS rule.
    plain="${TMP_DIR}/secrets/example.env"
    enc="${TMP_DIR}/example.sops.env"
    key_file="${HOME}/.config/sops/age/keys.txt"
    mkdir -p "$(dirname "$plain")"
    printf 'EXAMPLE_SECRET=hello\n' >"$plain"
    recipient="$(age-keygen -y "$key_file" | tail -n 1 2>/dev/null || true)"
    if [[ -z "$recipient" ]]; then
        add_check "secrets_roundtrip" false "could not derive age recipient"
        return
    fi
    # shellcheck disable=SC2016
    if sops --encrypt --age "$recipient" --input-type dotenv --output-type dotenv "$plain" >"$enc" \
        && with-secrets "$enc" -- \
            sh -c 'test "${EXAMPLE_SECRET:-}" = hello'; then
        add_check "secrets_roundtrip" true "SOPS dotenv consumed through with-secrets"
    else
        add_check "secrets_roundtrip" false "SOPS/with-secrets dummy secret failed"
    fi
}

has_plaintext_secret() {
    local path="$1"
    local line
    local shell_assignment_re
    local json_assignment_re
    local safe_re
    local empty_re
    shell_assignment_re='((OPENAI|ANTHROPIC|GEMINI)_API_KEY|GITHUB_TOKEN|GH_TOKEN|GITHUB_PAT|GH_PAT)[[:space:]]*='
    json_assignment_re='"((OPENAI|ANTHROPIC|GEMINI)_API_KEY|GITHUB_TOKEN|GH_TOKEN|GITHUB_PAT|GH_PAT)"[[:space:]]*:'
    token_re='(^|[^[:alnum:]_])(gh[pousr]_[[:alnum:]]{20,}|github_''pat_[[:alnum:]_]{20,})'
    safe_re='[:=][[:space:]]*"?replace-me"?[[:space:]]*[,}]?[[:space:]]*(#.*)?$|[:=][[:space:]]*"?ENC\['
    empty_re='(=[[:space:]]*$|:[[:space:]]*""[[:space:]]*[,}]?[[:space:]]*$)'
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ $token_re ]]; then
            return 0
        fi
        [[ "$line" =~ $shell_assignment_re \
            || "$line" =~ $json_assignment_re ]] || continue
        [[ "$line" =~ $safe_re || "$line" =~ $empty_re ]] && continue
        return 0
    done <"$path"
    return 1
}

is_env_like() {
    local path="$1"
    local base="${path##*/}"
    case "$base" in
        *.env.example) return 1 ;;
        .env|*.env|*.env.*) return 0 ;;
        *) return 1 ;;
    esac
}

check_plaintext_leaks() {
    local problems=()
    local path marker
    marker="AGE-SECRET-""KEY-"
    if ! git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        add_check "plaintext_leak_guard" false "repo is not a git checkout"
        return
    fi
    while IFS= read -r path; do
        [[ -f "${REPO_ROOT}/${path}" ]] || continue
        if grep -q "$marker" "${REPO_ROOT}/${path}"; then
            problems+=("${path}: age private key")
            continue
        fi
        if has_plaintext_secret "${REPO_ROOT}/${path}"; then
            problems+=("${path}: plaintext token or API-key assignment")
            continue
        fi
        if is_env_like "$path"; then
            if ! sops filestatus --input-type dotenv "${REPO_ROOT}/${path}" \
                    2>/dev/null | jq -e '.encrypted == true' >/dev/null; then
                problems+=("${path}: env-like file without SOPS metadata")
            fi
        fi
    done < <(git -C "$REPO_ROOT" ls-files --cached --others --exclude-standard)
    if ((${#problems[@]} == 0)); then
        add_check "plaintext_leak_guard" true \
            "no plaintext tokens, API keys, env files, or age keys tracked"
    else
        add_check "plaintext_leak_guard" false "${problems[*]}"
    fi
}

write_receipt() {
    local kit_rev
    kit_rev="$(tr -d '[:space:]' <"${REPO_ROOT}/KIT_REV")"
    python311 - "$VERSION" "$CHECKS_TSV" "$TOOLS_TSV" "$RECEIPT" \
        "$kit_rev" "$REPO_ROOT" <<'PY'
from __future__ import annotations

import json
import hashlib
import platform
import sys
from datetime import UTC, datetime
from pathlib import Path

version = int(sys.argv[1])
checks_tsv = Path(sys.argv[2])
tools_tsv = Path(sys.argv[3])
receipt = Path(sys.argv[4])
kit_rev = sys.argv[5]
repo_root = Path(sys.argv[6])

checks = []
for line in checks_tsv.read_text().splitlines():
    name, passed, detail = line.split("\t", 2)
    checks.append({"name": name, "passed": passed == "true", "detail": detail})

tools = {}
for line in tools_tsv.read_text().splitlines():
    name, path, version_text = line.split("\t", 2)
    tools[name] = {"path": path, "version": version_text}

payload = {
    "receipt_version": version,
    "kit_rev": kit_rev,
    "generated_at": datetime.now(UTC).isoformat(timespec="seconds"),
    "platform": {"os": platform.system(), "arch": platform.machine()},
    "checks": checks,
    "tools": tools,
    "homework_files": {
        relative: hashlib.sha256((repo_root / relative).read_bytes()).hexdigest()
        for relative in (
            "SUBMISSION.md",
            "AGENTS.md",
            "claude/settings.json",
            "codex/config.seed.toml",
        )
    },
}
receipt.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
PY
}

check_homework_complete() {
    # Reports the out-of-class HW0 items so students can tell when they are
    # actually done. Exit 0 only when nothing remains.
    #
    # The version goes through version_for, like every other tool. Reading the
    # first line here instead would hand hw0-check.py a diagnostic that has no
    # version in it, and the receipt would be withheld from a student whose
    # codex is correctly installed.
    python311 "${REPO_ROOT}/bin/hw0-check.py" --repo "$REPO_ROOT" \
        --codex-version "$(version_for codex || true)"
}

main() {
    cd "$REPO_ROOT"
    : >"$CHECKS_TSV"
    check_managed_links
    check_kit_revision
    check_update_remote
    check_core_tools
    check_github_auth
    check_codex_auth
    check_claude_auth
    check_age_key
    check_secrets_roundtrip
    check_plaintext_leaks

    if ((FAILURES != 0)); then
        rm -f "$RECEIPT"
        printf 'self-check failed; receipt not written\n' >&2
        return 1
    fi
    if ! check_homework_complete; then
        rm -f "$RECEIPT"
        printf 'HW0 items remain; receipt not written (TODO lines above)\n' >&2
        return 2
    fi
    add_check "homework_complete" true \
        "required submission, agent guidance, and permission policies pass"
    write_receipt
    printf 'wrote %s\n' "$RECEIPT" >&2
    printf 'HW0 complete: receipt and required committed artifacts are current\n' >&2
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
